{
  "kind": "installation-profile",
  "schemaVersion": 1,
  "profileId": "aln-full-kit",
  "label": "ALN \u2014 full kit",
  "version": 1,
  "forPack": "about-last-night",
  "orchestrator": true,
  "network": {
    "mode": "kit-network",
    "kitNetwork": {
      "ssid": "aboutlastnetwork",
      "orchestratorIp": "192.168.0.191",
      "localDnsOverride": false
    }
  },
  "endpoints": {
    "display.main": {
      "installed": true,
      "output": "hdmi-0"
    },
    "audio.sinks": [
      {
        "id": "hdmi",
        "installed": true,
        "label": "HDMI (monitor speakers)"
      },
      {
        "id": "bluetooth",
        "installed": true,
        "label": "W-KING X10"
      }
    ],
    "lighting.instruments": {
      "installed": true,
      "provider": "home-assistant"
    },
    "stations": {
      "count": 2
    },
    "personal": {
      "expected": false
    }
  },
  "bindings": {
    "lighting": {
      "gameplay": {
        "ha": "scene.game"
      },
      "video-playback": {
        "ha": "scene.video"
      },
      "blackout": {
        "ha": "scene.off"
      },
      "police-arrival-1": {
        "ha": "scene.police_1"
      },
      "police-arrival-2": {
        "ha": "scene.police2"
      },
      "police-arrival-3": {
        "ha": "scene.police3"
      },
      "police-glitch": {
        "ha": "scene.policeglitch"
      }
    },
    "surfaces": {
      "aln-idle": {
        "file": "idle-loop.mp4"
      }
    }
  }
}
