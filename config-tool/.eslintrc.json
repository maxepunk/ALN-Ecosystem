{
  "root": true,
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "env": {
    "es2022": true,
    "node": true
  },
  "rules": {
    "// no-unused-vars re-promoted to error 2026-09-06 (the Phase 0 baseline is cleaned); ignoreRestSiblings covers the rest-omit destructure idiom": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "ignoreRestSiblings": true }]
  },
  "overrides": [
    {
      "files": ["public/js/**/*.js"],
      "parserOptions": {
        "sourceType": "module"
      },
      "env": {
        "browser": true,
        "node": false
      }
    },
    {
      "files": ["tests/**/*.js"],
      "env": {
        "node": true
      }
    }
  ],
  "ignorePatterns": ["node_modules/", "presets/"]
}
